---
const { title = 'Biz Policy Radar' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={Astro.url.href} />
    <meta name="description" content="스타트업, 1인 사업자, 소상공인을 위한 공식 출처 기반 정책 인텔리전스" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="사업자를 위한 공식 출처 기반 정책·세무·노무 정보 큐레이션" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', name:'Biz Policy Radar', url:Astro.site?.toString() ?? 'https://ai4tenlab.github.io/biz-policy-radar/' })} />
    <style is:global>
      :root{
        --ink:oklch(18% .02 95);--soft-ink:oklch(30% .018 95);--muted:oklch(46% .015 95);--faint:oklch(62% .01 95);--paper:oklch(97% .012 95);--paper-deep:oklch(93.5% .014 95);--surface:oklch(99% .008 95 / .76);--surface-strong:oklch(100% 0 0);--rule:oklch(25% .02 95 / .12);--rule-strong:oklch(25% .02 95 / .22);--lacquer:oklch(9% .006 95);--lacquer-2:oklch(13% .008 95);--gold:oklch(84% .13 82);--gold-deep:oklch(61% .085 78);--patina:oklch(70% .105 190);--blue:oklch(58% .18 252);--radius:28px;--radius-sm:18px;--shadow:0 24px 90px oklch(18% .02 95 / .12);--blur:saturate(180%) blur(22px)
      }
      *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--paper)} body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Noto Sans KR',system-ui,sans-serif;color:var(--ink);background:linear-gradient(180deg,#fbfbfd 0%,var(--paper) 34%,#eef0f4 100%);letter-spacing:-.024em} a{color:inherit}.wrap{max-width:1180px;margin:auto;padding:0 24px}.site-header{position:sticky;top:0;z-index:30;background:oklch(99% 0 0 / .68);backdrop-filter:var(--blur);border-bottom:1px solid oklch(0% 0 0 / .06)}.site-header::after{content:"";position:absolute;left:0;bottom:-1px;height:1px;width:var(--scroll,0%);background:linear-gradient(90deg,var(--gold),var(--patina),var(--blue));transition:width .1s linear}.nav{height:56px;display:flex;align-items:center;gap:22px}.brand{font-weight:760;font-size:15px;text-decoration:none;letter-spacing:-.012em}.nav-links{display:flex;gap:18px;align-items:center;margin-left:auto}.nav a{font-size:13px;color:#1d1d1f;text-decoration:none;opacity:.82}.nav a:hover{opacity:1;color:var(--blue)}main{overflow:hidden}.hero{min-height:calc(100vh - 56px);display:grid;align-items:end;padding:90px 0 70px;position:relative}.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 72% 18%,oklch(84% .13 82 / .28),transparent 23%),radial-gradient(circle at 20% 10%,oklch(70% .105 190 / .22),transparent 28%),linear-gradient(180deg,#fff 0%,transparent 70%);z-index:0}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.72fr);gap:42px;align-items:end}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border:1px solid var(--rule);border-radius:999px;background:oklch(100% 0 0 / .64);backdrop-filter:var(--blur);font-size:12px;font-weight:700;color:var(--soft-ink);box-shadow:0 8px 34px oklch(30% .05 252 / .06)}.hero h1{font-size:clamp(56px,9.2vw,126px);line-height:.9;margin:22px 0 18px;font-weight:820;letter-spacing:-.078em}.hero p{font-size:clamp(19px,2.15vw,29px);line-height:1.38;color:var(--soft-ink);max-width:780px;margin:0}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.pill{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border-radius:999px;background:var(--ink);color:#fff;text-decoration:none;font-size:15px;font-weight:680;box-shadow:0 14px 30px oklch(18% .02 95 / .16)}.pill.gold{background:linear-gradient(135deg,var(--gold),oklch(92% .055 84));color:oklch(14% .018 95)}.pill.secondary{background:oklch(100% 0 0 / .68);color:#121621;border:1px solid var(--rule);box-shadow:none;backdrop-filter:var(--blur)}.daily-brief{background:var(--lacquer);color:#fff;border-radius:34px;padding:22px;box-shadow:0 30px 120px oklch(0% 0 0 / .24);position:relative;overflow:hidden}.daily-brief::before{content:"";position:absolute;inset:0;background:linear-gradient(140deg,oklch(84% .13 82 / .18),transparent 35%),radial-gradient(circle at 88% 18%,oklch(70% .105 190 / .26),transparent 32%)}.daily-brief>*{position:relative}.brief-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:34px}.live-dot{width:9px;height:9px;border-radius:50%;background:var(--patina);box-shadow:0 0 0 7px oklch(70% .105 190 / .14)}.brief-title{font-size:16px;color:oklch(88% 0 0);font-weight:760}.brief-date{font-size:12px;color:oklch(72% 0 0)}.brief-big{font-size:54px;line-height:.92;letter-spacing:-.06em;font-weight:780;margin:0 0 14px}.brief-caption{color:oklch(78% 0 0);line-height:1.55}.brief-rows{display:grid;gap:10px;margin-top:26px}.brief-row{display:flex;justify-content:space-between;gap:16px;border-top:1px solid oklch(100% 0 0 / .12);padding-top:12px;font-size:13px;color:oklch(82% 0 0)}.brief-row b{color:var(--gold)}.section{padding:106px 0}.section-kicker{font-size:12px;color:var(--gold-deep);font-weight:800;margin-bottom:12px;text-transform:uppercase;letter-spacing:.12em}.section h2{font-size:clamp(36px,5.2vw,76px);line-height:.98;letter-spacing:-.062em;margin:0 0 18px}.section-lead{font-size:clamp(18px,2vw,24px);line-height:1.48;color:var(--muted);max-width:790px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:30px}.section-head .section-lead{margin:0}.newsroom{display:grid;grid-template-columns:1.12fr .88fr;gap:18px}.lead-story,.side-story,.intel-panel,.segment-panel,.card{background:var(--surface);backdrop-filter:var(--blur);border:1px solid oklch(100% 0 0 / .76);box-shadow:var(--shadow);border-radius:var(--radius);padding:26px;text-decoration:none}.lead-story{min-height:500px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,#fff,oklch(96% .018 95));position:relative;overflow:hidden}.lead-story::after{content:"";position:absolute;right:-120px;top:-90px;width:420px;height:420px;border-radius:50%;background:conic-gradient(from 40deg,transparent,var(--gold),var(--patina),transparent);opacity:.28;animation:spin 18s linear infinite}.lead-story h3{font-size:clamp(34px,4.2vw,62px);line-height:.98;letter-spacing:-.06em;margin:16px 0}.side-stack{display:grid;gap:18px}.side-story{min-height:156px}.meta{font-size:12px;color:var(--muted);font-weight:750;letter-spacing:.04em;text-transform:uppercase}.tag{display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;background:oklch(84% .13 82 / .18);color:oklch(40% .08 80);font-size:12px;font-weight:780}.story-copy{color:var(--muted);line-height:1.6}.dashboard{display:grid;grid-template-columns:.9fr 1.1fr;gap:18px}.intel-panel.dark{background:linear-gradient(145deg,var(--lacquer),var(--lacquer-2));color:#fff;border-color:oklch(100% 0 0 / .10)}.intel-panel h3,.segment-panel h3{font-size:28px;letter-spacing:-.045em;margin:0 0 12px}.signal-list{display:grid;gap:12px;margin-top:24px}.signal{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:14px;border-radius:18px;background:oklch(100% 0 0 / .08);border:1px solid oklch(100% 0 0 / .10)}.signal i{width:9px;height:9px;border-radius:50%;background:var(--gold)}.signal span{color:oklch(78% 0 0);font-size:13px}.metric-board{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.metric{padding:22px;border-radius:22px;background:var(--surface-strong);border:1px solid var(--rule)}.metric strong{display:block;font-size:44px;letter-spacing:-.06em}.metric span{color:var(--muted);font-size:13px}.segment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.segment-panel{min-height:340px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.segment-panel::before{content:"";position:absolute;inset:auto -30% -40% 20%;height:220px;border-radius:50%;background:radial-gradient(circle,var(--tint),transparent 64%);opacity:.55}.segment-panel>*{position:relative}.segment-panel.startup{--tint:oklch(70% .105 190 / .34)}.segment-panel.solo{--tint:oklch(84% .13 82 / .34)}.segment-panel.small{--tint:oklch(58% .18 252 / .26)}.segment-panel ul{padding-left:18px;color:var(--muted);line-height:1.75}.notice-list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}.notice-list .card{box-shadow:0 14px 50px oklch(18% .02 95 / .07);padding:22px}.notice-list .badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:#e8f2ff;color:#075db3;font-size:12px;font-weight:700}.notice-list h2{font-size:22px;line-height:1.18;letter-spacing:-.045em;margin:16px 0 10px}.notice-list p{color:var(--muted);line-height:1.55}.status-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--rule);border-radius:28px;overflow:hidden;border:1px solid var(--rule);margin-top:30px}.status-strip .metric{border:0;border-radius:0;background:oklch(100% 0 0 / .72);backdrop-filter:var(--blur)}.empty-state{margin-top:34px;padding:42px;border-radius:var(--radius);background:var(--surface);border:1px solid var(--rule);box-shadow:var(--shadow)}.empty-state h3{font-size:30px;letter-spacing:-.045em;margin:0 0 10px}.empty-state p{color:var(--muted);line-height:1.65;margin:0}.disclaimer{margin-top:28px;padding:18px;border-radius:18px;background:oklch(97% .012 95);border:1px solid var(--rule);color:var(--muted);line-height:1.65}table{width:100%;border-collapse:collapse;display:block;overflow-x:auto;background:white;border-radius:18px}th,td{border-bottom:1px solid #edf0f4;padding:12px;text-align:left}footer{padding:44px 24px;color:#69707d;font-size:14px;text-align:center}.reveal{opacity:0;transform:translateY(38px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}.reveal.is-visible{opacity:1;transform:none}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:920px){.nav{height:auto;min-height:56px;align-items:flex-start;padding:15px 0}.nav-links{flex-wrap:wrap;gap:10px}.hero{min-height:auto;padding:64px 0}.hero-grid,.newsroom,.dashboard,.segment-grid,.notice-list,.status-strip{grid-template-columns:1fr}.section-head{display:block}.section{padding:74px 0}.hero h1{font-size:clamp(44px,14vw,78px)}.brief-big{font-size:42px}.lead-story{min-height:360px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.lead-story::after{animation:none}}
    </style>
  </head>
  <body>
    <header class="site-header"><div class="wrap nav"><a class="brand" href={base}>Biz Policy Radar</a><nav class="nav-links"><a href={`${base}deadline/`}>마감임박</a><a href={`${base}segments/startup/`}>스타트업</a><a href={`${base}segments/solo-business/`}>1인 사업자</a><a href={`${base}segments/small-business/`}>소상공인</a><a href={`${base}methodology/`}>출처 원칙</a><a href={`${base}corrections/`}>정정·업데이트</a><a href={`${base}about/`}>소개</a></nav></div></header>
    <main><slot /></main>
    <footer>Biz Policy Radar는 일반 정보 제공 서비스입니다. 신청 가능성·선정·지원금 수령·세무·노무·법률 판단을 보장하지 않으며, 최종 확인은 공식 원문과 관계 기관 안내를 기준으로 해야 합니다.</footer>
    <script is:inline>
      const io = new IntersectionObserver((entries)=>{for(const e of entries){if(e.isIntersecting)e.target.classList.add('is-visible')}},{threshold:.16});
      document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
      const header = document.querySelector('.site-header');
      const setProgress = () => {
        const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
        header?.style.setProperty('--scroll', `${Math.min(100, Math.max(0, scrollY / max * 100))}%`);
      };
      addEventListener('scroll', setProgress, { passive: true });
      setProgress();
    </script>
  </body>
</html>
