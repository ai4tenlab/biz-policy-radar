---
const { title = 'Biz Policy Radar' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={Astro.url.href} />
    <meta name="description" content="스타트업, 1인 사업자, 소상공인을 위한 공식 출처 기반 정책 인텔리전스" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="공식 출처로 검증한 사업자 정책·세무·노무 브리핑" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', name:'Biz Policy Radar', url:Astro.site?.toString() ?? 'https://ai4tenlab.github.io/biz-policy-radar/' })} />
    <style>
      :root{
        --ink:#0b0d12;--soft-ink:#303541;--muted:#6d7480;--line:rgba(18,24,38,.12);--paper:#f5f5f7;--surface:rgba(255,255,255,.72);--surface-strong:#fff;--accent:#0071e3;--accent-2:#00a3ff;--radius:28px;--shadow:0 24px 80px rgba(0,0,0,.10);--blur:saturate(180%) blur(22px)
      }
      *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--paper)} body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Noto Sans KR',system-ui,sans-serif;color:var(--ink);background:radial-gradient(circle at 50% -10%,#fff 0,#f5f5f7 44%,#eceef3 100%);letter-spacing:-.022em} a{color:inherit} .wrap{max-width:1180px;margin:auto;padding:0 24px}.site-header{position:sticky;top:0;z-index:20;background:rgba(251,251,253,.72);backdrop-filter:var(--blur);border-bottom:1px solid rgba(0,0,0,.06)}.nav{height:56px;display:flex;align-items:center;gap:22px}.brand{font-weight:700;font-size:15px;text-decoration:none;letter-spacing:-.01em}.nav-links{display:flex;gap:18px;align-items:center;margin-left:auto}.nav a{font-size:13px;color:#1d1d1f;text-decoration:none;opacity:.82}.nav a:hover{opacity:1;color:var(--accent)}main{overflow:hidden}.hero{min-height:calc(100vh - 56px);display:grid;place-items:center;text-align:center;padding:70px 24px 92px;position:relative}.hero::before{content:"";position:absolute;inset:8% 12% auto;height:52vh;background:radial-gradient(circle at 50% 20%,rgba(0,113,227,.24),transparent 56%),linear-gradient(120deg,rgba(255,255,255,.92),rgba(225,236,255,.42));filter:blur(8px);border-radius:999px;z-index:0}.hero-inner{position:relative;z-index:1;max-width:980px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.64);backdrop-filter:var(--blur);font-size:13px;color:var(--soft-ink);box-shadow:0 8px 34px rgba(20,40,70,.06)}.hero h1{font-size:clamp(52px,9vw,118px);line-height:.92;margin:22px 0 18px;font-weight:800;letter-spacing:-.075em}.hero p{font-size:clamp(19px,2.4vw,30px);line-height:1.36;color:var(--soft-ink);max-width:760px;margin:0 auto}.hero-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:34px}.pill{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border-radius:999px;background:var(--accent);color:#fff;text-decoration:none;font-size:15px;font-weight:650;box-shadow:0 14px 30px rgba(0,113,227,.24)}.pill.secondary{background:rgba(255,255,255,.68);color:#121621;border:1px solid var(--line);box-shadow:none;backdrop-filter:var(--blur)}.section{padding:108px 0}.section-kicker{font-size:15px;color:var(--accent);font-weight:750;margin-bottom:12px}.section h2{font-size:clamp(34px,5vw,72px);line-height:.98;letter-spacing:-.06em;margin:0 0 18px}.section-lead{font-size:clamp(18px,2vw,24px);line-height:1.45;color:var(--muted);max-width:760px}.policy-stage{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:stretch;margin-top:42px}.glass-panel,.card{background:var(--surface);backdrop-filter:var(--blur);border:1px solid rgba(255,255,255,.76);border-radius:var(--radius);box-shadow:var(--shadow);padding:28px}.radar-card{min-height:480px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;background:linear-gradient(145deg,#ffffff 0%,#eef5ff 48%,#f8f8fb 100%)}.radar-card::after{content:"";position:absolute;right:-90px;top:-90px;width:310px;height:310px;border-radius:50%;background:conic-gradient(from 180deg,rgba(0,113,227,.0),rgba(0,113,227,.26),rgba(0,163,255,.10),rgba(0,113,227,.0));animation:spin 14s linear infinite}.radar-card h3{font-size:42px;line-height:1;margin:0;letter-spacing:-.045em;position:relative;z-index:1}.radar-lines{display:grid;gap:12px;position:relative;z-index:1}.radar-line{height:56px;border-radius:18px;background:rgba(255,255,255,.66);border:1px solid rgba(0,0,0,.06);display:flex;align-items:center;justify-content:space-between;padding:0 16px;color:#293140}.radar-line b{font-size:14px}.radar-line span{font-size:13px;color:var(--muted)}.story-stack{display:grid;gap:14px}.story{padding:22px;border-radius:24px;background:rgba(255,255,255,.58);border:1px solid var(--line)}.story h3{font-size:20px;margin:0 0 8px;letter-spacing:-.035em}.story p{margin:0;color:var(--muted);line-height:1.55}.notice-list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}.notice-list .card{box-shadow:0 14px 50px rgba(0,0,0,.07);padding:22px}.notice-list .badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:#e8f2ff;color:#075db3;font-size:12px;font-weight:700}.notice-list h2{font-size:22px;line-height:1.18;letter-spacing:-.045em;margin:16px 0 10px}.notice-list p{color:var(--muted);line-height:1.55}.status-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}.metric{padding:26px;border-radius:26px;background:#111827;color:#fff}.metric strong{display:block;font-size:42px;letter-spacing:-.05em}.metric span{color:rgba(255,255,255,.68)}table{width:100%;border-collapse:collapse;display:block;overflow-x:auto;background:white;border-radius:18px}th,td{border-bottom:1px solid #edf0f4;padding:12px;text-align:left}footer{padding:44px 24px;color:#69707d;font-size:14px;text-align:center}.reveal{opacity:0;transform:translateY(38px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}.reveal.is-visible{opacity:1;transform:none}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:860px){.nav{height:auto;min-height:56px;align-items:flex-start;padding:15px 0}.nav-links{flex-wrap:wrap;gap:10px}.hero{min-height:78vh;padding-top:54px}.policy-stage,.notice-list,.status-grid{grid-template-columns:1fr}.section{padding:74px 0}.radar-card{min-height:360px}.hero h1{font-size:clamp(44px,14vw,76px)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.radar-card::after{animation:none}}
    </style>
  </head>
  <body>
    <header class="site-header"><div class="wrap nav"><a class="brand" href={base}>Biz Policy Radar</a><nav class="nav-links"><a href={`${base}deadline/`}>마감임박</a><a href={`${base}segments/startup/`}>스타트업</a><a href={`${base}segments/solo-business/`}>1인 사업자</a><a href={`${base}segments/small-business/`}>소상공인</a><a href={`${base}methodology/`}>검증 원칙</a><a href={`${base}status/`}>상태</a></nav></div></header>
    <main><slot /></main>
    <footer>이 페이지는 공식 공고를 바탕으로 한 일반 정보입니다. 신청 자격, 제출 서류, 세무·노무·법률 판단은 반드시 공식 원문과 관계 기관 또는 자격 전문가를 통해 확인하세요.</footer>
    <script is:inline>
      const io = new IntersectionObserver((entries)=>{for(const e of entries){if(e.isIntersecting)e.target.classList.add('is-visible')}},{threshold:.16});
      document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    </script>
  </body>
</html>
