---
const {
  title = '정책자금 내비 | Biz Policy Radar',
  description = '소상공인, 개인사업자, 중소기업, 예비창업자, 개인을 위한 공식출처 기반 정책자금 해석 사이트',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteUrl = new URL(base, Astro.site ?? 'https://ai4tenlab.github.io').toString();
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '정책자금 내비',
      alternateName: ['Biz Policy Radar', 'Policy Fund Navi'],
      url: siteUrl,
      description,
      inLanguage: 'ko-KR',
      publisher: { '@type': 'Organization', name: '4TENLAB' }
    })} />
    <style is:global>
      :root{
        --ink:#0f172a;--ink-2:#1e293b;--muted:#64748b;--line:#e2e8f0;--line-2:#cbd5e1;
        --bg:#f8fafc;--paper:#ffffff;--soft:#eff6ff;--blue:#2563eb;--blue-2:#1d4ed8;--navy:#0b1f4d;
        --green:#16a34a;--amber:#f59e0b;--red:#dc2626;--violet:#7c3aed;
        --radius:24px;--radius-sm:16px;--shadow:0 22px 70px rgba(15,23,42,.10);--shadow-sm:0 10px 28px rgba(15,23,42,.08);
      }
      *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--bg)} body{margin:0;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Noto Sans KR',system-ui,sans-serif;letter-spacing:-.025em;background:radial-gradient(circle at 15% 0%,#dbeafe 0,transparent 33rem),linear-gradient(180deg,#fff 0,#f8fafc 42rem,#eef2f7 100%)}
      a{color:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin-inline:auto}.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(18px);border-bottom:1px solid rgba(226,232,240,.8)}.nav{height:64px;display:flex;align-items:center;gap:18px}.brand{display:flex;flex-direction:column;text-decoration:none;line-height:1}.brand b{font-size:18px;letter-spacing:-.045em}.brand span{font-size:11px;color:var(--muted);margin-top:3px}.nav-links{display:flex;align-items:center;gap:6px;margin-left:auto}.nav-links a{font-size:14px;text-decoration:none;color:var(--ink-2);padding:9px 11px;border-radius:999px}.nav-links a:hover{background:var(--soft);color:var(--blue)}.nav-cta{background:var(--blue)!important;color:#fff!important;box-shadow:0 8px 18px rgba(37,99,235,.22)}
      main{overflow:hidden}.hero{padding:58px 0 44px}.hero-grid{display:grid;grid-template-columns:minmax(0,1.03fr) minmax(320px,.72fr);gap:28px;align-items:stretch}.eyebrow,.tag,.badge{display:inline-flex;align-items:center;width:max-content;gap:6px;border-radius:999px;font-size:12px;font-weight:800}.eyebrow{padding:8px 12px;background:#fff;border:1px solid var(--line);color:var(--blue);box-shadow:var(--shadow-sm)}.hero h1{font-size:clamp(40px,7vw,86px);line-height:.98;margin:18px 0 18px;letter-spacing:-.075em}.hero p,.section-lead{font-size:clamp(17px,2vw,21px);line-height:1.65;color:var(--ink-2);margin:0}.hero-actions,.quick-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.pill{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;border-radius:999px;text-decoration:none;font-weight:850;border:1px solid var(--line)}.pill.primary{background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 14px 34px rgba(37,99,235,.26)}.pill.secondary{background:#fff;color:var(--ink)}.pill.green{background:#ecfdf5;color:#166534;border-color:#bbf7d0}.pill.amber{background:#fffbeb;color:#92400e;border-color:#fde68a}.hero-panel{border:1px solid rgba(226,232,240,.85);background:rgba(255,255,255,.84);border-radius:32px;padding:22px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px}.panel-top{display:flex;justify-content:space-between;align-items:center}.live-dot{width:11px;height:11px;border-radius:50%;background:var(--green);box-shadow:0 0 0 8px rgba(22,163,74,.12)}.search-mock{height:54px;border:1px solid var(--line);border-radius:18px;background:#fff;display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--muted);font-weight:750}.ai-chip{background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;border-radius:999px;padding:6px 9px;font-size:12px}.mini-card{border:1px solid var(--line);border-radius:20px;padding:16px;background:linear-gradient(180deg,#fff,#f8fafc)}.mini-card h3{margin:8px 0 8px;font-size:18px}.mini-card p{font-size:14px;line-height:1.55;color:var(--muted);margin:0}.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:#f8fafc;border:1px solid var(--line);border-radius:18px;padding:13px}.stat b{display:block;font-size:22px}.stat span{font-size:12px;color:var(--muted);font-weight:700}
      .section{padding:54px 0}.section-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:22px}.section-kicker{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);font-weight:900;margin-bottom:8px}.section h2{font-size:clamp(30px,4.8vw,58px);line-height:1.05;letter-spacing:-.065em;margin:0}.section h3{letter-spacing:-.04em}.section-lead{max-width:680px}.surface{background:rgba(255,255,255,.78);border:1px solid var(--line);border-radius:32px;padding:22px;box-shadow:var(--shadow-sm)}.quick-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.quick-card{min-height:116px;text-decoration:none;background:#fff;border:1px solid var(--line);border-radius:24px;padding:17px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;justify-content:space-between}.quick-card i{font-style:normal;font-size:25px}.quick-card b{font-size:16px}.quick-card span{font-size:12px;color:var(--muted);line-height:1.35}.workspace-grid,.segment-grid,.dashboard{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.workspace-card,.segment-panel,.intel-panel{background:#fff;border:1px solid var(--line);border-radius:28px;padding:22px;box-shadow:var(--shadow-sm)}.workspace-card.feature{grid-column:span 2;background:linear-gradient(135deg,#0b1f4d,#1d4ed8);color:#fff}.workspace-card.feature p,.workspace-card.feature .story-copy{color:#dbeafe}.workspace-card h3,.segment-panel h3,.intel-panel h3{margin:8px 0 10px;font-size:24px}.story-copy{color:var(--muted);line-height:1.65}.tag{padding:6px 10px;background:var(--soft);color:var(--blue);border:1px solid #bfdbfe}.tag.green{background:#ecfdf5;color:#15803d;border-color:#bbf7d0}.tag.amber{background:#fffbeb;color:#b45309;border-color:#fde68a}.segment-panel{text-decoration:none}.segment-panel ul{margin:16px 0 0;padding-left:18px;color:var(--ink-2);line-height:1.8}.notice-list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:28px;padding:20px;box-shadow:var(--shadow-sm)}.card h2{font-size:21px!important;line-height:1.25;margin:12px 0}.card h2 a{text-decoration:none}.badge{padding:6px 10px;background:#eef2ff;color:#3730a3;border:1px solid #c7d2fe}.ai-summary{background:linear-gradient(180deg,#eff6ff,#f8fafc);border:1px solid #bfdbfe;border-radius:18px;padding:14px;margin:14px 0;color:var(--ink-2);line-height:1.55}.meta-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.meta-box{border:1px solid var(--line);border-radius:16px;padding:12px;background:#f8fafc}.meta-box span{display:block;color:var(--muted);font-size:12px;font-weight:800}.meta-box b{display:block;margin-top:4px}.empty-state{border:1px dashed var(--line-2);border-radius:28px;padding:28px;background:rgba(255,255,255,.72)}.detail-layout{display:grid;grid-template-columns:1fr 320px;gap:22px;align-items:start}.detail-main,.sticky-side{background:#fff;border:1px solid var(--line);border-radius:30px;padding:24px;box-shadow:var(--shadow-sm)}.sticky-side{position:sticky;top:86px}.checklist{list-style:none;margin:16px 0;padding:0;display:grid;gap:10px}.checklist li{padding:12px 14px;border:1px solid var(--line);border-radius:16px;background:#f8fafc}.checklist li::before{content:'✓';display:inline-grid;place-items:center;width:22px;height:22px;background:#dcfce7;color:#15803d;border-radius:50%;font-weight:900;margin-right:8px}.disclaimer{background:#fff7ed;border:1px solid #fed7aa;border-radius:18px;padding:14px;color:#9a3412;line-height:1.6}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:18px}.table-wrap table{min-width:620px;border-collapse:collapse;width:100%}.table-wrap th,.table-wrap td{padding:12px;border-bottom:1px solid var(--line);text-align:left}.table-wrap th{background:#f8fafc}.reveal{opacity:0;transform:translateY(18px);transition:.7s ease}.reveal.is-visible{opacity:1;transform:none}footer{width:min(1160px,calc(100% - 40px));margin:48px auto 28px;color:var(--muted);font-size:13px;line-height:1.65;border-top:1px solid var(--line);padding-top:22px}
      @media (max-width: 900px){.wrap{width:min(100% - 28px,760px)}.nav{height:58px}.brand span{display:none}.nav-links a:not(.nav-cta){display:none}.nav-cta{padding:8px 12px!important}.hero{padding:34px 0 26px}.hero-grid,.detail-layout{grid-template-columns:1fr}.hero h1{font-size:44px}.hero-panel{border-radius:26px}.section{padding:34px 0}.section-head{display:block}.section-lead{font-size:16px;margin-top:12px}.quick-grid{grid-template-columns:repeat(2,1fr)}.workspace-grid,.segment-grid,.dashboard,.notice-list{grid-template-columns:1fr}.workspace-card.feature{grid-column:auto}.stat-row{grid-template-columns:repeat(3,1fr)}.sticky-side{position:static;order:-1}.meta-grid{grid-template-columns:1fr}.pill{width:100%;min-height:48px}.hero-actions{display:grid;grid-template-columns:1fr 1fr}.hero-actions .pill{width:auto}.card{border-radius:22px}.quick-card{min-height:104px}.mobile-bottom-cta{position:sticky;bottom:12px;z-index:20;display:flex;gap:8px;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);padding:10px;border:1px solid var(--line);border-radius:999px;box-shadow:var(--shadow-sm)}}
      @media (max-width: 520px){.hero-actions{grid-template-columns:1fr}.quick-grid{grid-template-columns:1fr 1fr;gap:10px}.stat-row{grid-template-columns:1fr}.section h2{font-size:31px}.hero h1{font-size:39px}.hero p{font-size:16px}.surface,.workspace-card,.segment-panel,.intel-panel,.detail-main,.sticky-side{padding:18px;border-radius:22px}.nav-cta{font-size:13px!important}.quick-card b{font-size:14px}}
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={base} aria-label="정책자금 내비 홈"><b>정책자금 내비</b><span>Biz Policy Radar</span></a>
        <nav class="nav-links" aria-label="주요 메뉴">
          <a href={`${base}deadline/`}>마감임박</a>
          <a href={`${base}segments/small-business/`}>소상공인</a>
          <a href={`${base}segments/solo-business/`}>개인사업자</a>
          <a href={`${base}segments/startup/`}>예비창업</a>
          <a href={`${base}methodology/`}>출처 원칙</a>
          <a class="nav-cta" href={`${base}#ai-workspace`}>AI 도우미</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>정책자금 내비는 공식 공고를 쉽게 이해하도록 돕는 일반 정보 제공 사이트입니다. 신청 가능성, 선정, 대출 실행, 지원금 수령, 세무·노무·법률 판단을 보장하지 않으며, 최종 확인은 공식 원문과 관계 기관 안내를 기준으로 해야 합니다.</footer>
    <script is:inline>
      const io = new IntersectionObserver((entries)=>{for(const e of entries){if(e.isIntersecting)e.target.classList.add('is-visible')}},{threshold:.12});
      document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    </script>
  </body>
</html>
