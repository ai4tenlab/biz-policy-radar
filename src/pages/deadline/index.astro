---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notices } from '../../lib/data';
import NoticeCard from '../../components/NoticeCard.astro';
const items = notices().filter((n: any) => n.deadline_status === 'soon');
---
<BaseLayout title="오늘의 마감임박 | 정책자금 나침반 | Policy Fund Compass">
  <section class="section wrap reveal"><div class="section-kicker">Deadline</div><h2>오늘의 마감임박</h2><p class="section-lead">마감이 가까운 공식 정책 정보를 우선 정리합니다. 신청 전 기관 공고를 반드시 확인하세요.</p>{items.length > 0 ? <div class="notice-list">{items.map((notice: any) => <NoticeCard notice={notice} />)}</div> : <div class="empty-state"><h3>현재 공개된 마감임박 공고가 없습니다.</h3><p>확인을 마친 공식 브리핑이 준비되면 이곳에 표시됩니다.</p></div>}</section>
</BaseLayout>
