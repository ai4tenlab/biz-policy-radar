---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { notices } from '../../lib/data';
export function getStaticPaths(){ return notices().map(n => ({params:{slug:n.slug}, props:{notice:n}})); }
const { notice } = Astro.props;
---
<BaseLayout title={`${notice.title} | Biz Policy Radar`}><article class="card"><span class="badge">{notice.status}</span><h2>{notice.title}</h2><h3>1. 3줄 요약</h3><ul><li>SAMPLE fixture 기반 초안입니다.</li><li>공식 원문 URL과 검증 시각을 표시합니다.</li><li>실제 발행 전 운영자 검토가 필요합니다.</li></ul><h3>2. 지원 또는 정책 내용</h3><p>{notice.support_summary}</p><h3>3. 대상·조건</h3><p>{notice.segment.join(', ')}</p><h3>4. 신청·일정</h3><p>마감: {notice.deadline}</p><h3>5. 대상별 판단</h3><table><tr><th>대상</th><th>적합도</th><th>판단 근거</th></tr><tr><td>스타트업</td><td>Medium</td><td>원문 조건 검토 필요</td></tr><tr><td>1인 사업자</td><td>Medium</td><td>원문 조건 검토 필요</td></tr><tr><td>소상공인</td><td>Medium</td><td>원문 조건 검토 필요</td></tr></table><h3>6. 편집 메모</h3><p>사실과 판단을 분리하기 위한 데모입니다.</p><h3>7. 공식 원문</h3><p><a href={notice.source_url}>{notice.source_url}</a></p><p>검증 시각: {notice.verified_at}</p></article></BaseLayout>
