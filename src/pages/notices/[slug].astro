---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notices } from '../../lib/data';
export function getStaticPaths(){ return notices().map((notice: any)=>({params:{slug:notice.slug}, props:{notice}})); }
const { notice } = Astro.props;
const region = notice.region?.join(', ') || '지역 확인 필요';
const segments = notice.segment?.join(', ') || notice.support_target || '대상 확인 필요';
const themes = notice.theme?.join(', ') || '정책자금';
const statusLabel = notice.deadline_status === 'soon' || notice.status === 'deadline_soon' ? '마감임박' : '정책 정보';
---
<BaseLayout title={`${notice.title} | 정책자금 레이더 | Biz Policy Radar`} description="공식 공고 기준으로 지원 대상, 지원 내용, 신청 기간, 주의사항을 정리한 정책자금 해설입니다.">
  <section class="section wrap reveal">
    <a class="pill secondary" href="../">← 목록으로</a>
    <div class="detail-layout" style="margin-top:18px">
      <article class="detail-main">
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
          <span class="badge">{statusLabel}</span><span class="tag">{region}</span><span class="tag green">{themes}</span>
        </div>
        <h2>{notice.title}</h2>
        <p class="section-lead">공식 원문 기준 요약입니다. 신청 전 최신 공고, 제출 서류, 예산 소진 여부를 반드시 확인하세요.</p>

        <div class="ai-summary"><b>AI 검토 요약</b><br />{notice.support_summary}</div>

        <h3>내 사업 체크리스트</h3>
        <ul class="checklist">
          <li>내 사업장 또는 거주 지역이 공고 대상 지역에 포함되는지 확인했습니다.</li>
          <li>소상공인, 개인사업자, 중소기업, 예비창업자 등 대상 조건을 확인했습니다.</li>
          <li>보조금, 융자, 보증, 이차보전, 바우처 중 어떤 유형인지 확인했습니다.</li>
          <li>신청 마감일과 예산 소진 또는 조기 마감 가능성을 확인했습니다.</li>
          <li>공식 신청 페이지에서 접수 상태와 제출 서류를 다시 확인했습니다.</li>
        </ul>

        <h3>지원 대상</h3>
        <p class="story-copy">{segments}</p>

        <h3>지원 내용</h3>
        <div class="table-wrap">
          <table>
            <tbody>
              <tr><th>기관</th><td>{notice.issuer}</td></tr>
              <tr><th>주제</th><td>{themes}</td></tr>
              <tr><th>신청 기간·마감</th><td>{notice.deadline || '공식 공고 확인'}</td></tr>
              <tr><th>신청 방법</th><td>{notice.application_method || '공식 신청 경로 확인'}</td></tr>
              <tr><th>문의</th><td>{notice.inquiry || '공식 공고 확인'}</td></tr>
            </tbody>
          </table>
        </div>

        <h3>제외 조건·주의사항</h3>
        <ul>
          <li>지역 한정 공고를 전국 대상처럼 해석하지 마세요.</li>
          <li>융자와 보증은 지원금 수령이 아니라 상환 또는 금융기관 심사가 동반될 수 있습니다.</li>
          <li>체납, 휴·폐업, 중복지원, 업종 제한 등 제외 조건을 공식 공고에서 확인해야 합니다.</li>
        </ul>

        <h3>공식 원문</h3>
        <p><a href={notice.source_url}>{notice.source_url}</a></p>
        <p class="disclaimer">이 글은 공식 공고를 쉽게 이해하도록 돕기 위한 일반 정보 해설입니다. 최종 신청 가능 여부, 접수 상태, 제출 서류, 예산 소진 여부는 반드시 공식 공고와 담당기관 안내를 확인해야 합니다. 본 글은 선정 가능성이나 지원금 수령을 보장하지 않습니다.</p>
      </article>

      <aside class="sticky-side">
        <span class="tag amber">한눈에 보기</span>
        <div class="meta-grid" style="margin-top:14px">
          <div class="meta-box"><span>지역</span><b>{region}</b></div>
          <div class="meta-box"><span>대상</span><b>{segments}</b></div>
          <div class="meta-box"><span>주제</span><b>{themes}</b></div>
          <div class="meta-box"><span>마감</span><b>{notice.deadline || '확인 필요'}</b></div>
        </div>
        <div class="mobile-bottom-cta" style="margin-top:16px">
          <a class="pill primary" href={notice.source_url}>공식 공고 보기</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
