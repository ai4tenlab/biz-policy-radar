---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { statusSummary } from '../../lib/data'; const s = statusSummary();
---
<BaseLayout title="운영 상태 | Biz Policy Radar"><h2>운영 상태 대시보드</h2><div class="grid"><div class="card">PASS: {s.pass ?? 0}</div><div class="card">MANUAL_REVIEW: {s.manual_review ?? 0}</div><div class="card">BLOCK: {s.blocked ?? 0}</div><div class="card">마지막 수집: {s.generated_at ?? '없음'}</div></div></BaseLayout>
