---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notices } from '../../lib/data';
const correctionItems = notices().filter((notice: any) => {
  const title = String(notice.title ?? '');
  const summary = String(notice.change_summary ?? '');
  return title.includes('변경') || title.includes('정정') || summary.includes('보정') || summary.includes('변경') || notice.source_updated_at;
});
---
<BaseLayout title="정정·업데이트 | 정책자금 레이더 | Biz Policy Radar">
  <section class="section wrap reveal">
    <div class="section-kicker">Corrections</div>
    <h2>정정·업데이트 이력</h2>
    <p class="section-lead">정책 공고는 마감, 대상, 제출 서류가 바뀔 수 있습니다. 공식 원문에서 변경이 확인되거나 공개 상태를 보정한 경우, 독자에게 필요한 내용만 남깁니다.</p>
    {correctionItems.length > 0 ? <div class="notice-list">
      {correctionItems.map((notice: any) => <article class="card">
        <div style="display:flex;gap:6px;flex-wrap:wrap"><span class="badge">업데이트</span><span class="tag">{notice.issuer}</span></div>
        <h3>{notice.title}</h3>
        <p class="story-copy">{notice.change_summary}</p>
        <div class="meta-grid">
          <div class="meta-box"><span>신청 기간</span><b>{notice.deadline || '공식 공고 확인'}</b></div>
          <div class="meta-box"><span>확인 시각</span><b>{notice.verified_at || '공식 원문 확인'}</b></div>
        </div>
        <p class="story-copy"><a href={notice.source_url}>공식 원문 확인</a></p>
      </article>)}
    </div> : <div class="empty-state"><h3>현재 공개된 정정 이력이 없습니다.</h3><p>오류 또는 변경 사항이 확인되면 변경 전후 요약, 확인 시각, 공식 원문 링크를 함께 표시합니다.</p></div>}
  </section>
</BaseLayout>
