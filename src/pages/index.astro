---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeCard from '../components/NoticeCard.astro';
import { notices, publicSummary } from '../lib/data';
const items = notices();
const summary = publicSummary();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Biz Policy Radar | 사업자 정책 레이더">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">공식 출처 기반 사업자 정책 안내</div>
        <h1>사업자 정책,<br />마감 전에 확인하세요.</h1>
        <p>스타트업, 1인 사업자, 소상공인을 위해 공식 공고의 대상·마감·준비물을 읽기 쉽게 정리합니다. 신청 전 원문 확인은 필수입니다.</p>
        <div class="hero-actions">
          <a class="pill gold" href={`${base}deadline/`}>마감임박 보기</a>
          <a class="pill secondary" href={`${base}segments/startup/`}>내 대상별로 보기</a>
        </div>
      </div>
      <aside class="daily-brief" aria-label="오늘의 마감 브리핑">
        <div class="brief-top"><div><div class="brief-title">오늘의 마감 브리핑</div><div class="brief-date">공식 원문 중심 큐레이션</div></div><span class="live-dot"></span></div>
        <div class="brief-big">정책을<br />읽기 쉽게.</div>
        <p class="brief-caption">공고 제목만 나열하지 않고 대상, 마감, 준비할 일, 공식 원문을 한 화면에서 확인할 수 있게 정리합니다.</p>
        <div class="brief-rows">
          <div class="brief-row"><span>공개 콘텐츠</span><b>{summary.published}</b></div>
          <div class="brief-row"><span>마감 임박</span><b>{summary.deadlineSoon}</b></div>
          <div class="brief-row"><span>업데이트</span><b>{summary.updatedAt ?? '준비 중'}</b></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-head">
      <div><div class="section-kicker">Today</div><h2>오늘의 마감임박</h2></div>
      <p class="section-lead">접수 마감이 가까운 지원사업과 신고·납부 일정을 먼저 보여줍니다. 자격과 마감은 반드시 공식 원문으로 되돌아갈 수 있게 연결합니다.</p>
    </div>
    <div class="newsroom">
      <a class="lead-story" href={`${base}deadline/`}>
        <div><span class="tag">Deadline</span><h3>지금 놓치면 안 되는 정책 일정.</h3><p class="story-copy">마감일, 신청 대상, 준비 서류, 문의처를 독자가 바로 행동할 수 있는 순서로 정리합니다.</p></div>
        <div class="meta">공식 원문 연결 · 핵심 조건 요약 · 일반 정보 안내</div>
      </a>
      <div class="side-stack">
        <a class="side-story" href={`${base}themes/금융/`}><div class="meta">Funding</div><h3>자금·보증</h3><p class="story-copy">정책자금, 보증, 융자 정보를 사업 단계와 신청 가능성 중심으로 읽기 쉽게 정리합니다.</p></a>
        <a class="side-story" href={`${base}themes/세무/`}><div class="meta">Tax and Labor</div><h3>세무·노무</h3><p class="story-copy">신고·납부·고용 관련 일정을 놓치지 않도록 핵심 날짜와 확인 경로를 제공합니다.</p></a>
        <a class="side-story" href={`${base}corrections/`}><div class="meta">Updates</div><h3>변경·정정</h3><p class="story-copy">공고 변경, 마감 연장, 정정 사항은 별도 이력으로 남겨 신뢰도를 높입니다.</p></a>
      </div>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-head"><div><div class="section-kicker">Segments</div><h2>사업 형태별로<br />필요한 정보만.</h2></div><p class="section-lead">같은 공고라도 스타트업, 1인 사업자, 소상공인에게 필요한 판단 기준은 다릅니다.</p></div>
    <div class="segment-grid">
      <a class="segment-panel startup" href={`${base}segments/startup/`}><div><span class="tag">Startup</span><h3>스타트업</h3><p class="story-copy">창업지원, R&D, 사업화, 투자 연계 정보를 성장 단계 기준으로 정리합니다.</p></div><ul><li>사업화·R&D</li><li>창업패키지</li><li>기술·시장 실증</li></ul></a>
      <a class="segment-panel solo" href={`${base}segments/solo-business/`}><div><span class="tag">Solo Business</span><h3>1인 사업자</h3><p class="story-copy">혼자 운영하는 사업자가 바로 확인할 수 있게 세무, 디지털전환, 소규모 지원을 분리합니다.</p></div><ul><li>세무·노무 일정</li><li>디지털 전환</li><li>간편 신청성</li></ul></a>
      <a class="segment-panel small" href={`${base}segments/small-business/`}><div><span class="tag">Small Business</span><h3>소상공인</h3><p class="story-copy">자금, 판로, 고용, 지역 지원을 마감과 제출 준비 중심으로 정리합니다.</p></div><ul><li>자금·보증</li><li>판로·지역</li><li>고용 지원</li></ul></a>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-kicker">Trust</div>
    <h2>공식 원문과 확인 시각을<br />함께 봅니다.</h2>
    <p class="section-lead">지원 대상, 마감, 신청 경로처럼 의사결정에 필요한 사실을 원문 기준으로 정리합니다. 불확실한 내용은 단정하지 않습니다.</p>
    <div class="dashboard">
      <div class="intel-panel dark"><h3>정보 확인 방식</h3><div class="signal-list"><div class="signal"><i></i><b>공식 원문</b><span>정부·공공기관 자료 우선</span></div><div class="signal"><i></i><b>확인 시각</b><span>갱신 기준 명시</span></div><div class="signal"><i></i><b>변경 기록</b><span>마감·조건 변동 관리</span></div><div class="signal"><i></i><b>일반 정보</b><span>결과 보장 없음</span></div></div></div>
      <div class="intel-panel"><h3>곧 제공할 기능</h3><div class="metric-board"><div class="metric"><strong>D-day</strong><span>마감 일정 정렬</span></div><div class="metric"><strong>원문</strong><span>공식 링크 확인</span></div><div class="metric"><strong>대상</strong><span>사업 형태별 분류</span></div><div class="metric"><strong>정정</strong><span>변경 이력 관리</span></div></div></div>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-kicker">Latest</div>
    <h2>최근 정책 카드</h2>
    {items.length > 0 ? <div class="notice-list">{items.map((notice) => <NoticeCard notice={notice} />)}</div> : <div class="empty-state"><h3>첫 공식 브리핑을 준비 중입니다.</h3><p>확인을 마친 콘텐츠만 공개됩니다. 준비가 완료되면 이 영역에 마감 임박 정책 카드가 표시됩니다.</p></div>}
  </section>
</BaseLayout>
