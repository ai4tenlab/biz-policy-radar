---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeCard from '../components/NoticeCard.astro';
import { notices, publicSummary } from '../lib/data';
const items = notices();
const summary = publicSummary();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="정책자금 나침반 | Policy Fund Compass">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">공식출처 기반 · 정책자금 해석 · AI 확장 준비</div>
        <h1>내 사업에 맞는<br />정책자금의 길.</h1>
        <p>소상공인, 개인사업자, 중소기업, 예비창업자와 개인이 복잡한 정부·지자체·공공기관 공고를 빠르게 이해하고 “검토할 만한지” 판단하도록 돕습니다.</p>
        <div class="hero-actions">
          <a class="pill primary" href={`${base}deadline/`}>마감임박 보기</a>
          <a class="pill secondary" href="#ai-workspace">AI 도우미 구상</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="정책자금 검색 미리보기">
        <div class="panel-top"><div><b>정책자금 나침반</b><div class="story-copy">모바일·PC 반응형 탐색</div></div><span class="live-dot"></span></div>
        <div class="search-mock"><span class="ai-chip">AI</span><span>지역, 업종, 업력, 필요한 자금 목적을 입력하세요</span></div>
        <div class="mini-card">
          <span class="tag">AI 검토 요약</span>
          <h3>받을 수 있다는 단정 대신, 검토할 조건을 먼저 보여줍니다.</h3>
          <p>대상, 지역, 자금 유형, 한도, 신청 기간, 제외 조건, 공식 링크를 한 화면에서 확인합니다.</p>
        </div>
        <div class="stat-row">
          <div class="stat"><b>{summary.published}</b><span>공개 공고</span></div>
          <div class="stat"><b>{summary.deadlineSoon}</b><span>마감 임박</span></div>
          <div class="stat"><b>공식</b><span>원문 우선</span></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-head">
      <div><div class="section-kicker">Quick Access</div><h2>사용자는 공고명이 아니라<br />자기 상황으로 찾습니다.</h2></div>
      <p class="section-lead">모바일에서는 큰 버튼과 카드로 빠르게 훑고, PC에서는 필터·비교·상세 검토가 편하도록 설계합니다.</p>
    </div>
    <div class="quick-grid">
      <a class="quick-card" href={`${base}segments/small-business/`}><i>🏪</i><b>소상공인</b><span>매장·상권·경영안정</span></a>
      <a class="quick-card" href={`${base}segments/solo-business/`}><i>👤</i><b>개인사업자</b><span>1인·프리랜서형 사업</span></a>
      <a class="quick-card" href={`${base}themes/금융/`}><i>🏢</i><b>중소기업</b><span>운전·시설·보증</span></a>
      <a class="quick-card" href={`${base}segments/startup/`}><i>🚀</i><b>예비창업자</b><span>창업 전·초기창업</span></a>
      <a class="quick-card" href={`${base}deadline/`}><i>⏰</i><b>마감임박</b><span>기한·예산소진 주의</span></a>
      <a class="quick-card" href={`${base}methodology/`}><i>✅</i><b>공식출처</b><span>검증 원칙 확인</span></a>
    </div>
  </section>

  <section class="section wrap reveal" id="ai-workspace">
    <div class="section-head">
      <div><div class="section-kicker">Future AI Workspace</div><h2>나중에는 AI 정책자금 코치로<br />자연스럽게 확장합니다.</h2></div>
      <p class="section-lead">지금 쌓는 글과 태그, 메타데이터가 향후 추천·필요서류·한도 가늠·선생님모드·실전연습의 기반 데이터가 됩니다.</p>
    </div>
    <div class="workspace-grid">
      <article class="workspace-card feature"><span class="tag">추천 서비스 비전</span><h3>내 조건으로 찾기</h3><p class="story-copy">지역, 업종, 업력, 직원 수, 자금 목적을 입력하면 공식 공고 기준으로 검토할 만한 공고와 추가 확인 조건을 안내합니다.</p></article>
      <article class="workspace-card"><span class="tag green">서류AI</span><h3>필요서류</h3><p class="story-copy">사업자등록증, 납세증명, 매출증빙, 사업계획서 등 공고별 준비물을 체크리스트로 정리합니다.</p></article>
      <article class="workspace-card"><span class="tag amber">계산 보조</span><h3>한도 가늠</h3><p class="story-copy">공식 공고상 최대 한도와 실제 심사에서 달라질 수 있는 요소를 분리해서 설명합니다.</p></article>
      <article class="workspace-card"><span class="tag">선생님모드</span><h3>쉬운 설명</h3><p class="story-copy">융자, 보증, 이차보전, 바우처, 자부담, 예산소진 같은 용어를 초보자 눈높이로 풉니다.</p></article>
      <article class="workspace-card"><span class="tag green">실전연습</span><h3>신청 준비</h3><p class="story-copy">사업계획서 문항, 지원 필요성, 자금 사용계획, 발표평가 예상 질문을 연습합니다.</p></article>
    </div>
  </section>

  <section class="section wrap reveal">
    <div class="section-head"><div><div class="section-kicker">Policy Cards</div><h2>카드는 빠른 판단,<br />상세 글은 신청 전 검토.</h2></div><p class="section-lead">레퍼런스처럼 카드에는 AI 검토 요약, 지원 규모, 신청 기간, 주의 조건을 노출하고 상세 페이지에는 공식 원문과 체크리스트를 연결합니다.</p></div>
    {items.length > 0 ? <div class="notice-list">{items.map((notice) => <NoticeCard notice={notice} />)}</div> : <div class="empty-state"><h3>공식 검증을 마친 첫 정책자금 카드를 준비 중입니다.</h3><p class="story-copy">낮은 품질의 공고를 억지로 발행하지 않습니다. 공식 원문, 신청 기간, 대상 조건, 신청 링크가 확인된 공고만 공개됩니다.</p></div>}
  </section>

  <section class="section wrap reveal">
    <div class="dashboard">
      <div class="intel-panel"><span class="tag">Mobile First</span><h3>폰에서는 카드·요약·큰 버튼</h3><p class="story-copy">검색 유입, 공유 링크, 이동 중 확인을 고려해 핵심 조건을 먼저 보여줍니다. 상세 페이지에는 하단 고정 공식 링크를 둡니다.</p></div>
      <div class="intel-panel"><span class="tag">PC Ready</span><h3>PC에서는 필터·비교·원문 검토</h3><p class="story-copy">좌측 필터, 2~3열 카드, 우측 요약 패널, 긴 표의 가독성, 공식 원문 확인 흐름을 강화합니다.</p></div>
      <div class="intel-panel"><span class="tag amber">Safety</span><h3>결과 보장 표현 금지</h3><p class="story-copy">“받을 수 있다”가 아니라 “검토할 만하다”로 안내하고, 최종 가능 여부는 공식 공고와 기관 확인을 기준으로 합니다.</p></div>
    </div>
  </section>
</BaseLayout>
